<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SuperEconomico" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/fondo_cliente</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/fondo_cliente</item>
        <item name="android:windowBackground">@color/fondo_cliente</item>
        <item name="fontFamily">sans</item>

        <item name="textInputStyle">@style/Widget.SuperEconomico.CampoTexto</item>
    </style>

    <style name="Widget.SuperEconomico.CampoTexto" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/fondo_campo_cliente</item>
        <item name="boxStrokeColor">@color/selector_borde_campo</item>
        <item name="hintTextColor">@color/selector_texto_campo</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="android:textColorHint">@color/texto_apagado</item>
        <item name="startIconTint">@color/icono_cliente</item>
        <item name="endIconTint">@color/icono_cliente</item>
    </style>

    <style name="Widget.SuperEconomico.BotonPrincipal" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/verde_supermercado</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.SuperEconomico.BotonSecundario" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/borde_campo_cliente</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/verde_supermercado</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.SuperEconomico.BotonTexto" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/verde_supermercado</item>
    </style>

    <!-- Splash Screen API 31+ -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.SuperEconomico</item>
    </style>

    <style name="Widget.SuperEconomico.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconSize">32dp</item>
        <item name="itemPaddingTop">8dp</item>
        <item name="itemPaddingBottom">8dp</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.SuperEconomico.TabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="CustomDialogTheme" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
