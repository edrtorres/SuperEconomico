<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Imagen del Producto -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvItemImage"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F1F5E9">

            <ImageView
                android:id="@+id/ivItemImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:scaleType="centerInside"
                tools:src="@android:drawable/ic_menu_report_image" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/llItemInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/cvItemImage"
            android:layout_toStartOf="@id/tvQuantityLabel"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Nombre del Producto"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvItemPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="L. 0.00"
                android:textColor="@color/primary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvQuantityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="#E1F2E9"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Cant: 1"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Hidden controls for modifications (User requested NO modifications here) -->
        <LinearLayout
            android:id="@+id/llQuantityControls"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">
            <View android:id="@+id/btnDecrease" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/btnIncrease" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/btnDelete" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/tvQuantity" android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
