<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fondo_cliente"
    tools:context=".presentation.ui.LoginActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="42dp"
            android:paddingBottom="36dp">

            <TextView
                android:id="@+id/tvLoginTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Iniciar sesión"
                android:textColor="@color/verde_supermercado_oscuro"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="42dp"
                android:text="Cuenta"
                android:textColor="@color/verde_supermercado"
                android:textSize="19sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/Widget.SuperEconomico.CampoTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Correo electrónico o teléfono"
                app:boxStrokeColor="@color/selector_borde_campo"
                app:startIconDrawable="@drawable/icono_correo"
                app:startIconTint="@color/icono_cliente">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/text_field"
                    android:textColorHint="@color/texto_apagado"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.SuperEconomico.CampoTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Contraseña"
                app:boxStrokeColor="@color/selector_borde_campo"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/icono_contrasena"
                app:startIconTint="@color/icono_cliente">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textColor="@color/text_field"
                    android:textColorHint="@color/texto_apagado"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecoverPassword"
                style="@style/Widget.SuperEconomico.BotonTexto"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:text="¿Olvidaste tu contraseña?"
                android:textAllCaps="false"
                android:textColor="@color/verde_supermercado"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbRememberUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/verde_supermercado"
                android:text="Recordar mi usuario"
                android:textColor="@color/text_field"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cbAcceptPolicyLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="@color/verde_supermercado"
                android:text="Acepto política de privacidad y uso de GPS"
                android:textColor="@color/text_field"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                style="@style/Widget.SuperEconomico.BotonPrincipal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:text="Ingresar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoToRegister"
                style="@style/Widget.SuperEconomico.BotonTexto"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="¿No tienes cuenta? Crear cuenta"
                android:textAllCaps="false"
                android:textColor="@color/verde_supermercado" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>